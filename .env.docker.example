# Environment template for the Docker/Portainer deployment (docker-compose.yml).
# Copy these into the stack's "Environment variables" section in Portainer —
# do NOT commit a real, filled-in copy of this file.

APP_NAME="CMB Core Marketing"
APP_ENV=production
# Generate ONCE (e.g. `php artisan key:generate --show` locally) and never
# change afterwards — see docker/entrypoint.sh's comment for why.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Container-friendly logging — Docker/Portainer captures stdout/stderr
# natively, no log file/volume needed.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# DB_HOST is the compose service name, not an IP — Docker's internal DNS
# resolves it to the mysql container.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cmbcoremkt
DB_USERNAME=cmbcoremkt
DB_PASSWORD=
# Only consumed by the mysql container's own environment block
# (docker-compose.yml) — the app never connects as root.
DB_ROOT_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# REQUIRED in production — an empty value disables SePay webhook auth entirely
# (anyone could self-credit/self-activate).
SEPAY_WEBHOOK_TOKEN=
SEPAY_MATCH_PATTERN=CMB
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Name of the pre-existing external Docker network your Portainer nginx/reverse
# proxy is attached to (check with `docker network ls` on the host) — the
# `app` service joins it so that proxy can route to this stack.
PROXY_NETWORK_NAME=nginx-proxy
